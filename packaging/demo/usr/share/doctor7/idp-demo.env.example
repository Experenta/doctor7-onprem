# doctor7-onprem demo: settings of the mock identity provider.
#
# Demo only. Do not install this on a production server.
#
# Each line has the form NAME=value. This file holds names only. Fill in the values
# on the demo host. Then run: systemctl enable --now doctor7-mock-idp.service
#
# MOCK_IDP_PUBLIC_URL     Public issuer, exactly https://<host>/idp, with no trailing slash.
# MOCK_IDP_REDIRECT_URIS  Callback of the demo, exactly https://<host>/api/auth/callback.
# MOCK_IDP_CLIENT_ID      Client identifier that the API uses at this provider.
MOCK_IDP_PUBLIC_URL=
MOCK_IDP_REDIRECT_URIS=
MOCK_IDP_CLIENT_ID=
