#!/bin/sh
set -e

IDP_USER=doctor7-idp
ENV_DIR=/etc/doctor7
ENV_FILE=/etc/doctor7/idp-demo.env
SHARE_DIR=/usr/share/doctor7
UNIT=doctor7-mock-idp.service

# The Google Meet simulator (K-36). Demo only.
MEET_USER=doctor7-meet
API_GROUP=doctor7
MEET_ENV_FILE=/etc/doctor7/mock-google.env
MEET_API_ENV_FILE=/etc/doctor7/meet-demo-credentials.env
MEET_PUBLIC_KEY=/etc/doctor7/meet-demo-public-key.pem
MEET_PORT=4020
MEET_SA_EMAIL=meet-sa@doctor7-test.example.test
MEET_DELEGATED_USER=clinic.organizer@example.test
MEET_UNIT=doctor7-mock-google.service

# The nightly reset of the demo database (K-37). Demo only. Nothing here enables or starts it.
RESET_USER=doctor7-reset
RESET_ENV_FILE=/etc/doctor7/demo-reset.env
RESET_TIMER=doctor7-demo-reset.timer

systemd_running() {
  [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

# Makes a synthetic RSA key pair and a shared control secret on this host, and writes three
# files. Nothing is stored in the package or in the repository. The private key lives only in
# a 0700 temporary folder, which is removed at the end, and in the API settings file. The
# files are created only when none of them exists, so an upgrade never replaces a key.
generate_meet_files() {
  if [ -e "$MEET_ENV_FILE" ] || [ -e "$MEET_API_ENV_FILE" ] || [ -e "$MEET_PUBLIC_KEY" ]; then
    if [ ! -e "$MEET_ENV_FILE" ] || [ ! -e "$MEET_API_ENV_FILE" ] || [ ! -e "$MEET_PUBLIC_KEY" ]; then
      echo "doctor7-demo: some Meet simulator files exist and others do not. Nothing was generated." >&2
      echo "doctor7-demo: remove the remaining ones and reinstall to generate a new set." >&2
    fi
    return 0
  fi
  if ! command -v openssl >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1; then
    echo "doctor7-demo: openssl or awk is missing, so the Meet simulator files were not created." >&2
    return 0
  fi

  old_umask=$(umask)
  umask 077
  work=$(mktemp -d /tmp/doctor7-meet.XXXXXX) || { umask "$old_umask"; return 0; }
  if openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$work/key.pem" 2>/dev/null \
    && openssl pkey -in "$work/key.pem" -pubout -out "$work/public.pem" 2>/dev/null; then
    secret=$(openssl rand -hex 32)
    # The key on one line, with each line break written as the two characters \n, as JSON needs.
    key_line=$(awk 'BEGIN { ORS = "\\n" } { print }' "$work/key.pem")

    install -m 0640 -o root -g "$MEET_USER" /dev/null "$MEET_ENV_FILE"
    {
      printf '# Generated by doctor7-demo. Demo only. Settings of the Google Meet simulator.\n'
      printf 'MOCK_GOOGLE_CONTROL_SECRET=%s\n' "$secret"
      printf 'MOCK_GOOGLE_PUBLIC_KEY_FILE=%s\n' "$MEET_PUBLIC_KEY"
    } > "$MEET_ENV_FILE"

    install -m 0640 -o root -g "$MEET_USER" /dev/null "$MEET_PUBLIC_KEY"
    cat "$work/public.pem" > "$MEET_PUBLIC_KEY"

    install -m 0640 -o root -g "$API_GROUP" /dev/null "$MEET_API_ENV_FILE"
    {
      printf '# Generated by doctor7-demo. Demo only. Synthetic key, never for production.\n'
      printf '# Read by systemd as root, after the drop-in of docs/DEMO.md is installed.\n'
      printf 'VIDEO_PROVIDER=meet\n'
      printf 'DEMO_MODE=1\n'
      printf 'GOOGLE_MEET_DELEGATED_USER=%s\n' "$MEET_DELEGATED_USER"
      printf 'GOOGLE_MEET_API_BASE_URL=http://127.0.0.1:%s\n' "$MEET_PORT"
      printf 'DEMO_MEET_CONTROL_URL=http://127.0.0.1:%s\n' "$MEET_PORT"
      printf 'DEMO_MEET_CONTROL_SECRET=%s\n' "$secret"
      printf "GOOGLE_SERVICE_ACCOUNT_JSON='{\"type\":\"service_account\",\"project_id\":\"doctor7-demo\",\"private_key_id\":\"demo-synthetic-key\",\"private_key\":\"%s\",\"client_email\":\"%s\",\"token_uri\":\"http://127.0.0.1:%s/token\"}'\n" "$key_line" "$MEET_SA_EMAIL" "$MEET_PORT"
    } > "$MEET_API_ENV_FILE"
    echo "doctor7-demo: generated the synthetic Meet simulator key and secret." >&2
  else
    echo "doctor7-demo: openssl could not make a key pair, so the Meet simulator files were not created." >&2
  fi
  rm -rf "$work"
  umask "$old_umask"
  return 0
}

case "$1" in
  configure)
    if ! getent passwd "$IDP_USER" >/dev/null 2>&1; then
      adduser --system --group --home /nonexistent --no-create-home "$IDP_USER"
    fi
    if ! getent passwd "$MEET_USER" >/dev/null 2>&1; then
      adduser --system --group --home /nonexistent --no-create-home "$MEET_USER"
    fi

    if ! getent passwd "$RESET_USER" >/dev/null 2>&1; then
      adduser --system --group --home /nonexistent --no-create-home "$RESET_USER"
    fi

    install -d -m 0755 -o root -g root "$ENV_DIR"

    # Create the settings file from the template. Never overwrite it.
    if [ ! -e "$ENV_FILE" ]; then
      install -m 0640 -o root -g "$IDP_USER" "$SHARE_DIR/idp-demo.env.example" "$ENV_FILE"
    fi

    # The reset settings hold a database credential once filled in. Same rule: never overwrite.
    if [ ! -e "$RESET_ENV_FILE" ]; then
      install -m 0640 -o root -g "$RESET_USER" "$SHARE_DIR/demo-reset.env.example" "$RESET_ENV_FILE"
    fi

    generate_meet_files

    if systemd_running; then
      systemctl daemon-reload || true
      if [ -n "$2" ]; then
        # Upgrade: restart the services only when they already run. Never start them.
        systemctl try-restart "$UNIT" >/dev/null 2>&1 || true
        systemctl try-restart "$MEET_UNIT" >/dev/null 2>&1 || true
        # The timer only. The reset service is never restarted, because that would erase data.
        systemctl try-restart "$RESET_TIMER" >/dev/null 2>&1 || true
      else
        echo "doctor7-demo: installed. Nothing is enabled or started." >&2
        echo "doctor7-demo: edit $ENV_FILE, then run: systemctl enable --now $UNIT" >&2
        echo "doctor7-demo: for the Meet outage switch, follow docs/DEMO.md, then run: systemctl enable --now $MEET_UNIT" >&2
        echo "doctor7-demo: the nightly reset stays off. To use it, fill in $RESET_ENV_FILE, then run: systemctl enable --now $RESET_TIMER" >&2
      fi
    fi
    ;;
  abort-upgrade | abort-remove | abort-deconfigure)
    ;;
  *)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
