# doctor7-onprem API settings. This file is read by systemd (EnvironmentFile).
# Format: NAME=value, one per line. No "export", no spaces around "=".
# Values with spaces or JSON go in single quotes.
# The file must stay root-owned with mode 0600. docs/OPERATIONS.md describes
# every variable.

# Path to the Node.js binary (version 22 or later). Optional. Without it the
# service tries /opt/node/current/bin/node and then node from PATH.
#NODE_BIN=

# Server
#HOST=127.0.0.1
#PORT=3000
# One reverse proxy (Apache) in front of the API.
TRUST_PROXY=1
#RATE_LIMIT_WINDOW_MS=
#RATE_LIMIT_MAX=

# Database: mysql:// address. Required.
DATABASE_URL=

# Sign-in. Set the first three together.
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_REDIRECT_URI=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPE=
#AUTH_POST_LOGIN_PATH=
#SESSION_COOKIE_NAME=
#SESSION_ABSOLUTE_TTL_SECONDS=
#SESSION_IDLE_TTL_SECONDS=

# Video: meet or jitsi.
#VIDEO_PROVIDER=
#JITSI_BASE_URL=
#JITSI_APP_ID=
#JITSI_JWT_SECRET=
#GOOGLE_SERVICE_ACCOUNT_JSON=
#GOOGLE_MEET_DELEGATED_USER=
#GOOGLE_MEET_API_BASE_URL=
#MEET_TIMEOUT_MS=

# Chat
#CHAT_RETENTION_DAYS=
