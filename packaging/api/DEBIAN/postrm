#!/bin/sh
set -e

case "$1" in
  remove | purge)
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
    fi
    ;;
esac

case "$1" in
  purge)
    # Settings can hold secrets, so purge removes them. The state directory,
    # the backups and the service user stay: they hold data. Remove them by hand.
    rm -f /etc/doctor7/api.env /etc/doctor7/backup.conf
    rmdir /etc/doctor7 2>/dev/null || true
    ;;
  remove | upgrade | failed-upgrade | abort-install | abort-upgrade | disappear)
    ;;
  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
