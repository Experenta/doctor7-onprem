#!/bin/sh
set -e

systemd_running() {
  [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1
}

case "$1" in
  remove | upgrade | deconfigure)
    if systemd_running; then
      systemctl stop doctor7-chat-purge.timer >/dev/null 2>&1 || true
      systemctl stop doctor7-api.service >/dev/null 2>&1 || true
      if [ "$1" = "remove" ]; then
        systemctl disable doctor7-chat-purge.timer doctor7-api.service >/dev/null 2>&1 || true
      fi
    fi
    ;;
  failed-upgrade)
    ;;
  *)
    echo "prerm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

exit 0
