{
  "enabled": true,
  "name": "Secret scan on save",
  "description": "When a file is saved, runs the secret and forbidden-word scanner over the files that would be committed. Format: Kiro agent hook (fileEdited trigger, runCommand action). This format was written from the Kiro hook schema as understood at creation and was not checked against a running Kiro instance. Verify it in the IDE before relying on it.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "node scripts/scan-secrets.js"
  }
}
